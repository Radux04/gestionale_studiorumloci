@page "/dipendenti"
@inherits PaginaBase
@attribute [Authorize(Roles = Ruoli.Gestione)]

<PageTitle>Dipendenti · Studiorum Loci</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Dipendenti</h1>
    @if (Sessione.PuoAmministrare)
    {
        <button class="btn btn-primary" @onclick="ApriNuovo"><i class="bi bi-plus-lg"></i> Nuovo dipendente</button>
    }
</div>

<Avvisi Errore="@(modulo is null ? Errore : null)" Conferma="@Conferma" />

<div class="row g-2 align-items-center mb-3">
    <div class="col-sm-4 col-lg-3">
        <SelezioneEnum TEnum="RuoloDipendente" Valore="filtroRuolo" ValoreChanged="CambiaRuolo" TestoTutti="Tutte le mansioni" />
    </div>
    <div class="col-sm-4 col-lg-3">
        <SelezioneSede Sedi="sedi" Valore="filtroSede" ValoreChanged="CambiaSede" />
    </div>
    <div class="col-auto">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="soloAttivi" @bind="soloAttivi" @bind:after="Carica" />
            <label class="form-check-label" for="soloAttivi">Solo attivi</label>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr><th>Dipendente</th><th>Mansione</th><th>Accesso</th><th>Contratto</th><th>Sedi</th><th>Materie</th><th class="text-end">€/ora</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var d in dipendenti)
            {
                <tr class="@(d.Attivo ? "" : "text-body-secondary")">
                    <td>
                        <a href="dipendenti/@d.Id">@d.NomeCompleto</a>
                        @if (!d.Attivo) { <span class="badge text-bg-secondary ms-1">Cessato</span> }
                    </td>
                    <td>@Testo.Di(d.Ruolo)</td>
                    <td><BadgeAccesso Accesso="d.Accesso" /></td>
                    <td>@Testo.Di(d.Contratto)</td>
                    <td>
                        @if (d.SediIds.Length == 0) { <span class="text-body-secondary">—</span> }
                        @foreach (var id in d.SediIds) { <span class="badge text-bg-light border me-1">@NomeSede(id)</span> }
                    </td>
                    <td>@d.Materie</td>
                    <td class="text-end">@Testo.Euro(d.CompensoOrario)</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" href="dipendenti/@d.Id" title="Turni e compensi"><i class="bi bi-calendar-week"></i></a>
                        <button class="btn btn-sm btn-outline-primary" title="Modifica" @onclick="() => ApriModifica(d)"><i class="bi bi-pencil"></i></button>
                        @if (Sessione.PuoAmministrare && d.Id != Sessione.Utente?.DipendenteId)
                        {
                            <BottoneConferma Testo="Elimina (anche turni e accesso)" Icona="bi-trash" OnConferma="() => Elimina(d)" />
                        }
                    </td>
                </tr>
            }
            @if (dipendenti.Count == 0 && !Caricamento)
            {
                <tr><td colspan="8" class="text-body-secondary">Nessun dipendente trovato.</td></tr>
            }
        </tbody>
    </table>
</div>

<Finestra Visibile="modulo is not null" Titolo="@(idInModifica is null ? "Nuovo dipendente" : "Modifica dipendente")" Grande OnChiudi="() => modulo = null">
    @if (modulo is not null)
    {
        <Avvisi Errore="@Errore" />
        <ModuloDipendente Modello="modulo" Sedi="sedi" Disabilitato="Caricamento" OnSalva="Salva" />
    }
</Finestra>

<PasswordTemporanea Dati="credenziali" OnChiudi="() => credenziali = null" />

@code {
    [SupplyParameterFromQuery] public int? SedeId { get; set; }

    private List<DipendenteDto> dipendenti = [];
    private List<SedeDto> sedi = [];
    private RuoloDipendente? filtroRuolo;
    private int? filtroSede;
    private bool soloAttivi = true;

    [Inject] private Sessione Sessione { get; set; } = null!;

    private DipendenteInput? modulo;
    private int? idInModifica;
    private PasswordTemporaneaDto? credenziali;

    protected override async Task OnInitializedAsync()
    {
        filtroSede = SedeId;
        await Esegui(async () => sedi = await Api.Sedi());
        await Carica();
    }

    private Task Carica() => Esegui(async () => dipendenti = await Api.Dipendenti(filtroRuolo, soloAttivi, filtroSede));

    private string NomeSede(int id) => sedi.FirstOrDefault(s => s.Id == id)?.Nome ?? $"#{id}";

    private Task CambiaRuolo(RuoloDipendente? ruolo)
    {
        filtroRuolo = ruolo;
        return Carica();
    }

    private Task CambiaSede(int? sedeId)
    {
        filtroSede = sedeId;
        return Carica();
    }

    private void ApriNuovo()
    {
        idInModifica = null;
        Errore = null;
        // Se sto guardando una sede, il nuovo dipendente parte già assegnato a quella.
        modulo = new NuovoDipendenteInput { SediIds = filtroSede is > 0 ? [filtroSede.Value] : [] };
    }

    private void ApriModifica(DipendenteDto d)
    {
        idInModifica = d.Id;
        Errore = null;
        modulo = DipendenteInput.Da(d);
    }

    private async Task Salva()
    {
        PasswordTemporaneaDto? nuoveCredenziali = null;
        var ok = await Esegui(async () =>
        {
            if (modulo is NuovoDipendenteInput nuovo) nuoveCredenziali = (await Api.CreaDipendente(nuovo)).Accesso;
            else await Api.ModificaDipendente(idInModifica!.Value, modulo!);
        });
        if (!ok) return;

        var nome = $"{modulo!.Nome} {modulo.Cognome}";
        modulo = null;
        await Carica();
        Conferma = $"{nome} salvato.";
        credenziali = nuoveCredenziali;
    }

    private async Task Elimina(DipendenteDto d)
    {
        if (await Esegui(() => Api.EliminaDipendente(d.Id)))
        {
            await Carica();
            Conferma = $"{d.NomeCompleto} eliminato.";
        }
    }
}
