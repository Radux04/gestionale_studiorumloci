@page "/dipendenti"
@inherits PaginaBase

<PageTitle>Dipendenti · Studiorum Loci</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Dipendenti</h1>
    <button class="btn btn-primary" @onclick="ApriNuovo"><i class="bi bi-plus-lg"></i> Nuovo dipendente</button>
</div>

<Avvisi Errore="@Errore" Conferma="@Conferma" />

<div class="row g-2 align-items-center mb-3">
    <div class="col-sm-4 col-lg-3">
        <SelezioneEnum TEnum="RuoloDipendente" Valore="filtroRuolo" ValoreChanged="CambiaRuolo" TestoTutti="Tutti i ruoli" />
    </div>
    <div class="col-auto">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="soloAttivi" @bind="soloAttivi" @bind:after="Carica" />
            <label class="form-check-label" for="soloAttivi">Solo attivi</label>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr><th>Dipendente</th><th>Ruolo</th><th>Contratto</th><th>Materie</th><th class="text-end">€/ora</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var d in dipendenti)
            {
                <tr class="@(d.Attivo ? "" : "text-body-secondary")">
                    <td>
                        <a href="dipendenti/@d.Id">@d.NomeCompleto</a>
                        @if (!d.Attivo) { <span class="badge text-bg-secondary ms-1">Cessato</span> }
                    </td>
                    <td>@Testo.Di(d.Ruolo)</td>
                    <td>@Testo.Di(d.Contratto)</td>
                    <td>@d.Materie</td>
                    <td class="text-end">@Testo.Euro(d.CompensoOrario)</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" href="dipendenti/@d.Id" title="Turni e compensi"><i class="bi bi-calendar-week"></i></a>
                        <button class="btn btn-sm btn-outline-primary" title="Modifica" @onclick="() => ApriModifica(d)"><i class="bi bi-pencil"></i></button>
                        <BottoneConferma Testo="Elimina (anche i turni)" Icona="bi-trash" OnConferma="() => Elimina(d)" />
                    </td>
                </tr>
            }
            @if (dipendenti.Count == 0 && !Caricamento)
            {
                <tr><td colspan="6" class="text-body-secondary">Nessun dipendente trovato.</td></tr>
            }
        </tbody>
    </table>
</div>

<Finestra Visibile="modulo is not null" Titolo="@(idInModifica is null ? "Nuovo dipendente" : "Modifica dipendente")" Grande OnChiudi="() => modulo = null">
    @if (modulo is not null)
    {
        <Avvisi Errore="@Errore" />
        <ModuloDipendente Modello="modulo" Disabilitato="Caricamento" OnSalva="Salva" />
    }
</Finestra>

@code {
    private List<DipendenteDto> dipendenti = [];
    private RuoloDipendente? filtroRuolo;
    private bool soloAttivi = true;

    private DipendenteInput? modulo;
    private int? idInModifica;

    protected override Task OnInitializedAsync() => Carica();

    private Task Carica() => Esegui(async () => dipendenti = await Api.Dipendenti(filtroRuolo, soloAttivi));

    private Task CambiaRuolo(RuoloDipendente? ruolo)
    {
        filtroRuolo = ruolo;
        return Carica();
    }

    private void ApriNuovo()
    {
        idInModifica = null;
        modulo = new DipendenteInput();
    }

    private void ApriModifica(DipendenteDto d)
    {
        idInModifica = d.Id;
        modulo = DipendenteInput.Da(d);
    }

    private async Task Salva()
    {
        var ok = await Esegui(() => idInModifica is { } id ? Api.ModificaDipendente(id, modulo!) : Api.CreaDipendente(modulo!));
        if (ok)
        {
            var nome = $"{modulo!.Nome} {modulo.Cognome}";
            modulo = null;
            await Carica();
            Conferma = $"{nome} salvato.";
        }
    }

    private async Task Elimina(DipendenteDto d)
    {
        if (await Esegui(() => Api.EliminaDipendente(d.Id)))
        {
            await Carica();
            Conferma = $"{d.NomeCompleto} eliminato.";
        }
    }
}
