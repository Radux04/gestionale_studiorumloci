@page "/dipendenti/{Id:int}"
@inherits PaginaBase

<PageTitle>@(dipendente?.NomeCompleto ?? "Dipendente") · Studiorum Loci</PageTitle>

@if (gestione)
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="dipendenti">Dipendenti</a></li>
            <li class="breadcrumb-item active">@dipendente?.NomeCompleto</li>
        </ol>
    </nav>
}

<Avvisi Errore="@(modulo is null && turnoInModifica is null ? Errore : null)" Conferma="@Conferma" />

@if (dipendente is not null)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="mb-0">
            @(gestione ? dipendente.NomeCompleto : "I miei turni")
            @if (!dipendente.Attivo) { <span class="badge text-bg-secondary fs-6 align-middle">Cessato</span> }
        </h1>
        <div class="d-flex gap-2">
            @if (gestione)
            {
                <button class="btn btn-outline-primary" @onclick="ApriModifica"><i class="bi bi-pencil"></i> Modifica</button>
            }
            @if (amministrazione && !seStesso)
            {
                @if (dipendente.Attivo)
                {
                    <BottoneConferma Testo="Cessa rapporto (blocca anche l'accesso)" Classe="btn-outline-secondary" OnConferma="Cessa" />
                }
                <BottoneConferma Testo="Elimina" Icona="bi-trash" OnConferma="Elimina" />
            }
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header">Anagrafica</div>
                <div class="card-body">
                    <dl class="mb-0">
                        <dt>Mansione</dt><dd>@Testo.Di(dipendente.Ruolo) · @Testo.Di(dipendente.Contratto)</dd>
                        <dt>Compenso</dt><dd>@Testo.Euro(dipendente.CompensoOrario) / ora</dd>
                        <dt>Materie</dt><dd>@(dipendente.Materie ?? "—")</dd>
                        <dt>Contatti</dt><dd>@(dipendente.Email ?? "—")<br />@dipendente.Telefono</dd>
                        <dt>Codice fiscale</dt><dd>@(dipendente.CodiceFiscale ?? "—")</dd>
                        <dt>Sedi</dt>
                        <dd>
                            @if (dipendente.SediIds.Length == 0) { <span class="text-body-secondary">Nessuna sede assegnata</span> }
                            @foreach (var s in sedi.Where(s => dipendente.SediIds.Contains(s.Id)))
                            {
                                <div><i class="bi bi-geo-alt"></i> @s.Nome <span class="text-body-secondary small">@s.Localita</span></div>
                            }
                        </dd>
                        <dt>In servizio</dt>
                        <dd class="mb-0">dal @Testo.Data(dipendente.DataAssunzione)@(dipendente.DataCessazione is { } c ? $" al {Testo.Data(c)}" : "")</dd>
                    </dl>
                </div>
            </div>

            @if (amministrazione && !seStesso)
            {
                <div class="card mb-3">
                    <div class="card-header">Accesso al gestionale</div>
                    <div class="card-body">
                        @if (dipendente.Accesso is null)
                        {
                            <p class="small text-body-secondary">Non ha ancora un accesso.</p>
                        }
                        else
                        {
                            <div class="mb-2">
                                <BadgeAccesso Accesso="dipendente.Accesso" />
                                <span class="small text-body-secondary ms-1">
                                    @(dipendente.Accesso.UltimoAccesso is { } ua ? $"ultimo accesso {Testo.DataOra(ua)}" : "mai entrato")
                                </span>
                            </div>
                        }
                        @if (dipendente.Accesso is null || modificabile)
                        {
                            <EditForm Model="accesso" OnValidSubmit="SalvaAccesso">
                                <DataAnnotationsValidator />
                                <div class="mb-2">
                                    <label class="form-label small mb-1">Email di accesso</label>
                                    <InputText class="form-control form-control-sm" type="email" autocomplete="off" @bind-Value="accesso.Email" />
                                    <ValidationMessage For="() => accesso.Email" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small mb-1">Ruolo</label>
                                    <InputSelect class="form-select form-select-sm" @bind-Value="accesso.Ruolo">
                                        <option value="@RuoloAccesso.Professore">Professore</option>
                                        <option value="@RuoloAccesso.Manager">Manager</option>
                                    </InputSelect>
                                </div>
                                <button class="btn btn-sm btn-primary w-100" disabled="@Caricamento">
                                    @(dipendente.Accesso is null ? "Crea accesso" : "Salva email e ruolo")
                                </button>
                            </EditForm>
                            @if (dipendente.Accesso is { } a)
                            {
                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    <BottoneConferma Testo="Reimposta password" Classe="btn-outline-secondary" OnConferma="ReimpostaPassword" />
                                    @if (a.Attivo)
                                    {
                                        <BottoneConferma Testo="Blocca accesso" Classe="btn-outline-danger" OnConferma="() => CambiaStatoAccesso(false)" />
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => CambiaStatoAccesso(true)">Sblocca accesso</button>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            }

            @if (compenso is not null)
            {
                <div class="card border-primary">
                    <div class="card-header">Compenso del periodo</div>
                    <div class="card-body">
                        <div class="fs-3 fw-semibold">@Testo.Euro(compenso.Totale)</div>
                        <div class="text-body-secondary">@Testo.Ore(compenso.OreTotali) × @Testo.Euro(compenso.CompensoOrario)</div>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex flex-wrap align-items-center gap-2">
                    <span class="me-auto">Turni</span>
                    <input type="month" class="form-control form-control-sm w-auto" value="@mese.ToString("yyyy-MM")" @onchange="CambiaMese" />
                </div>
                <div class="card-body">
                    @if (gestione)
                    {
                    <EditForm Model="nuovoTurno" OnValidSubmit="AggiungiTurno" class="row g-2 align-items-end mb-3">
                        <div class="col-sm-4">
                            <label class="form-label small">Inizio</label>
                            <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="nuovoTurno.Inizio" />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label small">Fine</label>
                            <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="nuovoTurno.Fine" />
                        </div>
                        <div class="col-sm-2">
                            <InputText class="form-control" placeholder="Note" @bind-Value="nuovoTurno.Note" />
                        </div>
                        <div class="col-sm-2 d-grid">
                            <button class="btn btn-primary" disabled="@Caricamento">Aggiungi</button>
                        </div>
                    </EditForm>
                    }

                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th>Giorno</th><th>Orario</th><th class="text-end">Ore</th><th>Note</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var t in turni)
                                {
                                    <tr>
                                        <td class="text-capitalize">@t.Inizio.ToString("ddd dd/MM")</td>
                                        <td>@t.Inizio.ToString("HH:mm") – @t.Fine.ToString("HH:mm")</td>
                                        <td class="text-end">@Testo.Ore(t.Ore)</td>
                                        <td>@t.Note</td>
                                        <td class="text-end text-nowrap">
                                            @if (gestione)
                                            {
                                                <button class="btn btn-sm btn-outline-primary" title="Modifica" @onclick="() => ApriTurno(t)"><i class="bi bi-pencil"></i></button>
                                                <BottoneConferma Testo="Elimina" Icona="bi-trash" OnConferma="() => EliminaTurno(t)" />
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (turni.Count == 0)
                                {
                                    <tr><td colspan="5" class="text-body-secondary">Nessun turno nel mese selezionato.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<Finestra Visibile="modulo is not null" Titolo="Modifica dipendente" Grande OnChiudi="() => modulo = null">
    @if (modulo is not null)
    {
        <Avvisi Errore="@Errore" />
        <ModuloDipendente Modello="modulo" Sedi="sedi" Disabilitato="Caricamento" OnSalva="Salva" />
    }
</Finestra>

<Finestra Visibile="turnoInModifica is not null" Titolo="Modifica turno" OnChiudi="() => turnoInModifica = null">
    @if (turnoInModifica is not null)
    {
        <Avvisi Errore="@Errore" />
        <EditForm Model="turnoModulo" OnValidSubmit="SalvaTurno">
            <div class="row g-2 mb-3">
                <div class="col-sm-6">
                    <label class="form-label">Inizio</label>
                    <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="turnoModulo.Inizio" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label">Fine</label>
                    <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="turnoModulo.Fine" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Note</label>
                <InputText class="form-control" @bind-Value="turnoModulo.Note" />
            </div>
            <button class="btn btn-primary" disabled="@Caricamento">Salva</button>
        </EditForm>
    }
</Finestra>

<PasswordTemporanea Dati="credenziali" OnChiudi="() => credenziali = null" />

@code {
    [Parameter] public int Id { get; set; }
    [Inject] private NavigationManager Navigazione { get; set; } = null!;
    [Inject] private Sessione Sessione { get; set; } = null!;

    private bool gestione => Sessione.PuoGestire;
    private bool amministrazione => Sessione.PuoAmministrare;
    private bool seStesso => Sessione.Utente?.DipendenteId == Id;
    /// <summary>L'admin gestisce solo accessi da manager/professore (il superadmin tutti).</summary>
    private bool modificabile => dipendente?.Accesso is { } a && Ruoli.Assegnabili(Sessione.Utente!.Ruolo).Contains(a.Ruolo);

    private UtenteInput accesso = new();
    private PasswordTemporaneaDto? credenziali;

    private DipendenteDto? dipendente;
    private List<SedeDto> sedi = [];
    private DipendenteInput? modulo;
    private DateOnly mese = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private List<TurnoDto> turni = [];
    private CompensoDto? compenso;
    private TurnoInput nuovoTurno = new();
    private TurnoDto? turnoInModifica;
    private TurnoInput turnoModulo = new();

    private DateOnly FineMese => mese.AddMonths(1).AddDays(-1);

    protected override async Task OnParametersSetAsync()
    {
        await Esegui(async () =>
        {
            dipendente = await Api.Dipendente(Id);
            sedi = await Api.Sedi();
        });
        PreparaAccesso();
        await CaricaTurni();
    }

    private void PreparaAccesso() => accesso = dipendente?.Accesso is { } a
        ? new UtenteInput { Email = a.Email, Ruolo = a.Ruolo, Attivo = a.Attivo, DipendenteId = Id }
        : new UtenteInput { Email = dipendente?.Email ?? "", Ruolo = RuoloAccesso.Professore, DipendenteId = Id };

    private void ApriModifica()
    {
        Errore = null;
        modulo = DipendenteInput.Da(dipendente!);
    }

    private async Task SalvaAccesso()
    {
        await Esegui(async () =>
        {
            if (dipendente!.Accesso is { } a) await Api.ModificaUtente(a.UtenteId, accesso);
            else credenziali = await Api.CreaUtente(accesso);
            dipendente = await Api.Dipendente(Id);
        }, dipendente!.Accesso is null ? "Accesso creato." : "Accesso aggiornato.");
        PreparaAccesso();
    }

    private async Task CambiaStatoAccesso(bool attivo)
    {
        accesso.Attivo = attivo;
        await Esegui(async () =>
        {
            await Api.ModificaUtente(dipendente!.Accesso!.UtenteId, accesso);
            dipendente = await Api.Dipendente(Id);
        }, attivo ? "Accesso sbloccato." : "Accesso bloccato: la persona è stata disconnessa.");
        PreparaAccesso();
    }

    private Task ReimpostaPassword() => Esegui(async () =>
    {
        credenziali = await Api.ReimpostaPassword(dipendente!.Accesso!.UtenteId);
        dipendente = await Api.Dipendente(Id);
    });

    private Task CaricaTurni() => Esegui(async () =>
    {
        turni = await Api.Turni(Id, mese, FineMese);
        compenso = await Api.Compenso(Id, mese, FineMese);
    });

    private Task CambiaMese(ChangeEventArgs e)
    {
        if (DateOnly.TryParseExact($"{e.Value}-01", "yyyy-MM-dd", out var m)) mese = m;
        return CaricaTurni();
    }

    private async Task AggiungiTurno()
    {
        if (await Esegui(() => Api.AggiungiTurno(Id, nuovoTurno)))
        {
            // Propone lo stesso orario il giorno dopo, comodo per inserire una settimana.
            nuovoTurno = new TurnoInput { Inizio = nuovoTurno.Inizio.AddDays(1), Fine = nuovoTurno.Fine.AddDays(1) };
            await CaricaTurni();
        }
    }

    private async Task EliminaTurno(TurnoDto t)
    {
        if (await Esegui(() => Api.EliminaTurno(Id, t.Id))) await CaricaTurni();
    }

    private async Task Salva()
    {
        if (await Esegui(async () => dipendente = await Api.ModificaDipendente(Id, modulo!), "Dati salvati."))
        {
            modulo = null;
            await CaricaTurni();
        }
    }

    private Task Cessa() => Esegui(async () =>
    {
        await Api.CessaDipendente(Id);
        dipendente = await Api.Dipendente(Id);
    }, "Rapporto cessato.");

    private async Task Elimina()
    {
        if (await Esegui(() => Api.EliminaDipendente(Id))) Navigazione.NavigateTo("dipendenti");
    }

    private void ApriTurno(TurnoDto t)
    {
        turnoInModifica = t;
        turnoModulo = TurnoInput.Da(t);
        Errore = null;
    }

    private async Task SalvaTurno()
    {
        if (await Esegui(() => Api.ModificaTurno(Id, turnoInModifica!.Id, turnoModulo)))
        {
            turnoInModifica = null;
            await CaricaTurni();
        }
    }
}
