@page "/pagamenti"
@inherits PaginaBase
@attribute [Authorize(Roles = Ruoli.Gestione)]

<PageTitle>Pagamenti · Studiorum Loci</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Pagamenti</h1>
    <button class="btn btn-primary" @onclick="ApriNuovo"><i class="bi bi-plus-lg"></i> Nuovo pagamento</button>
</div>

<Avvisi Errore="@(modulo is null && daIncassare is null ? Errore : null)" Conferma="@Conferma" />

<div class="row g-2 mb-3">
    <div class="col-sm-6 col-lg-4">
        <SelezioneSede Sedi="sedi" Valore="filtroSede" ValoreChanged="CambiaSede" />
    </div>
</div>

@if (riepilogo is not null)
{
    <div class="card mb-3">
        <div class="card-body d-flex flex-wrap align-items-center gap-4">
            <div>
                <input type="month" class="form-control w-auto" value="@meseRiepilogo.ToString("yyyy-MM")" @onchange="CambiaMeseRiepilogo" />
                <div class="small text-body-secondary mt-1">@NomeFiltroSede</div>
            </div>
            <div><div class="small text-body-secondary">Atteso</div><div class="fs-5 fw-semibold">@Testo.Euro(riepilogo.Atteso)</div></div>
            <div><div class="small text-body-secondary">Incassato</div><div class="fs-5 fw-semibold text-success">@Testo.Euro(riepilogo.Incassato)</div></div>
            <div><div class="small text-body-secondary">Da incassare</div><div class="fs-5 fw-semibold">@Testo.Euro(riepilogo.DaIncassare)</div></div>
            <div><div class="small text-body-secondary">Scaduti</div><div class="fs-5 fw-semibold @(riepilogo.NumeroScaduti > 0 ? "text-danger" : "")">@riepilogo.NumeroScaduti</div></div>
        </div>
    </div>
}

<div class="row g-2 align-items-center mb-3">
    <div class="col-sm-4 col-lg-3">
        <select class="form-select" value="@(filtroStudente?.ToString() ?? "")" @onchange="CambiaStudente">
            <option value="">Tutti gli studenti</option>
            @foreach (var s in StudentiDellaSede) { <option value="@s.Id">@s.NomeCompleto</option> }
        </select>
    </div>
    <div class="col-sm-4 col-lg-3">
        <SelezioneEnum TEnum="StatoPagamento" Valore="filtroStato" ValoreChanged="CambiaStato" TestoTutti="Tutti gli stati" />
    </div>
    <div class="col-auto">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="scaduti" @bind="soloScaduti" @bind:after="Carica" />
            <label class="form-check-label" for="scaduti">Solo scaduti</label>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr><th>Scadenza</th><th>Studente</th><th>Causale</th><th class="text-end">Importo</th><th>Stato</th><th>Incasso</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var p in pagamenti)
            {
                <tr class="@(p.Stato == StatoPagamento.Annullato ? "text-body-secondary text-decoration-line-through" : "")">
                    <td>@Testo.Data(p.Scadenza)</td>
                    <td>@p.Studente</td>
                    <td>@p.Causale</td>
                    <td class="text-end">@Testo.Euro(p.Importo)</td>
                    <td><span class="badge @Testo.BadgePagamento(p)">@Testo.Stato(p)</span></td>
                    <td class="text-nowrap">
                        @if (p.Stato == StatoPagamento.Pagato && p.Metodo is { } metodo)
                        {
                            <i class="bi @IconaMetodo(metodo) me-1" title="@Testo.Di(metodo)"></i>
                            @Testo.Di(metodo)
                            <span class="text-body-secondary">· @Testo.Data(p.DataPagamento)</span>
                        }
                        @if (p.Ricevuta is { } r)
                        {
                            <ApriRicevuta PagamentoId="p.Id" Ricevuta="r" Classe="ms-1 align-baseline" />
                        }
                        else if (p.Stato == StatoPagamento.Pagato && p.Metodo == MetodoPagamento.Bonifico)
                        {
                            <button type="button" class="btn btn-link p-0 ms-1 align-baseline text-warning" title="Ricevuta del bonifico non allegata: clicca per aggiungerla"
                                    @onclick="() => ApriModifica(p)"><i class="bi bi-exclamation-circle"></i></button>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        @if (p.Stato == StatoPagamento.DaPagare)
                        {
                            <button class="btn btn-sm btn-success" @onclick="() => ApriIncasso(p)"><i class="bi bi-check-lg"></i> Incassa</button>
                        }
                        <button class="btn btn-sm btn-outline-primary" title="Modifica" @onclick="() => ApriModifica(p)"><i class="bi bi-pencil"></i></button>
                        @if (p.Stato == StatoPagamento.DaPagare)
                        {
                            <BottoneConferma Testo="Annulla quota" Icona="bi-x-lg" Classe="btn-outline-secondary" OnConferma="() => Annulla(p)" />
                        }
                        else
                        {
                            <BottoneConferma Testo="Riporta a «da pagare»" Icona="bi-arrow-counterclockwise" Classe="btn-outline-secondary" OnConferma="() => Ripristina(p)" />
                        }
                        <BottoneConferma Testo="Elimina definitivamente" Icona="bi-trash" OnConferma="() => Elimina(p)" />
                    </td>
                </tr>
            }
            @if (pagamenti.Count == 0 && !Caricamento)
            {
                <tr><td colspan="7" class="text-body-secondary">Nessun pagamento trovato.</td></tr>
            }
        </tbody>
        @if (pagamenti.Count > 0)
        {
            <tfoot>
                <tr class="fw-semibold">
                    <td colspan="3">Totale (esclusi annullati)</td>
                    <td class="text-end">@Testo.Euro(pagamenti.Where(p => p.Stato != StatoPagamento.Annullato).Sum(p => p.Importo))</td>
                    <td colspan="3"></td>
                </tr>
            </tfoot>
        }
    </table>
</div>

<Finestra Visibile="modulo is not null" Titolo="@(idInModifica is null ? "Nuovo pagamento" : "Modifica pagamento")" OnChiudi="() => modulo = null">
    @if (modulo is not null)
    {
        <Avvisi Errore="@Errore" />
        <EditForm Model="modulo" OnValidSubmit="Salva">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label">Studente</label>
                <InputSelect class="form-select" @bind-Value="modulo.StudenteId">
                    <option value="0">— seleziona —</option>
                    @foreach (var s in StudentiDellaSede.Where(s => s.Attivo || s.Id == modulo.StudenteId))
                    {
                        <option value="@s.Id">@s.NomeCompleto</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => modulo.StudenteId" />
            </div>
            <div class="mb-3">
                <label class="form-label">Causale</label>
                <InputText class="form-control" placeholder="es. Retta ottobre 2026" @bind-Value="modulo.Causale" />
                <ValidationMessage For="() => modulo.Causale" />
            </div>
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label">Importo (€)</label>
                    <InputNumber class="form-control" step="0.01" @bind-Value="modulo.Importo" />
                    <ValidationMessage For="() => modulo.Importo" />
                </div>
                <div class="col-6">
                    <label class="form-label">Scadenza</label>
                    <InputDate class="form-control" @bind-Value="modulo.Scadenza" />
                </div>
            </div>
            @if (idInModifica is null)
            {
                <fieldset class="border rounded p-3 mb-3 bg-body-tertiary">
                    <legend class="float-none w-auto px-2 fs-6 mb-0">Pagamento</legend>
                    <div class="btn-group w-100 mb-3" role="group" aria-label="Stato del pagamento">
                        <input type="radio" class="btn-check" name="statoNuovo" id="daIncassare" checked="@(!incassatoSubito)" @onchange="() => ImpostaIncassato(false)" />
                        <label class="btn btn-outline-secondary" for="daIncassare"><i class="bi bi-hourglass"></i> Da incassare</label>
                        <input type="radio" class="btn-check" name="statoNuovo" id="giaIncassato" checked="@incassatoSubito" @onchange="() => ImpostaIncassato(true)" />
                        <label class="btn btn-outline-success" for="giaIncassato"><i class="bi bi-check-lg"></i> Già incassato</label>
                    </div>
                    @if (incassatoSubito)
                    {
                        <label class="form-label">Come ha pagato?</label>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @foreach (var m in Enum.GetValues<MetodoPagamento>())
                            {
                                var principale = m is MetodoPagamento.Contanti or MetodoPagamento.Bonifico;
                                <input type="radio" class="btn-check" name="metodoNuovo" id="metodo@(m)" checked="@(modulo.Metodo == m)" @onchange="() => modulo.Metodo = m" />
                                <label class="btn @(principale ? "btn-outline-primary" : "btn-outline-secondary btn-sm align-self-center")" for="metodo@(m)">
                                    @if (principale) { <i class="bi @IconaMetodo(m) me-1"></i> }
                                    @Testo.Di(m)
                                </label>
                            }
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Data incasso</label>
                            <InputDate class="form-control" @bind-Value="modulo.DataPagamento" />
                        </div>
                        @if (modulo.Metodo == MetodoPagamento.Bonifico)
                        {
                            <div class="mt-3">
                                <label class="form-label">Ricevuta del bonifico <span class="text-body-secondary">(facoltativa)</span></label>
                                <InputFile class="form-control" accept="@Ricevute.Accept" OnChange="e => ricevutaNuova = e.File" />
                                <div class="form-text">
                                    @if (ricevutaNuova is null)
                                    {
                                        <span><i class="bi bi-info-circle"></i> Foto (JPG, PNG, HEIC) o PDF, massimo 10 MB. Puoi allegarla anche dopo, da «Modifica».</span>
                                    }
                                    else
                                    {
                                        <span class="text-success"><i class="bi bi-check-circle"></i> @ricevutaNuova.Name (@Testo.Dimensione(ricevutaNuova.Size))</span>
                                    }
                                </div>
                            </div>
                        }
                    }
                </fieldset>
            }
            @if (inModifica?.Stato == StatoPagamento.Pagato)
            {
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">Metodo di pagamento</label>
                        <InputSelect class="form-select" @bind-Value="modulo.Metodo">
                            @foreach (var m in Enum.GetValues<MetodoPagamento>()) { <option value="@m">@Testo.Di(m)</option> }
                        </InputSelect>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Data incasso</label>
                        <InputDate class="form-control" @bind-Value="modulo.DataPagamento" />
                    </div>
                </div>
            }
            <div class="mb-3">
                <label class="form-label">Note</label>
                <InputTextArea class="form-control" rows="2" @bind-Value="modulo.Note" />
            </div>
            @if (inModifica is not null && (modulo.Metodo == MetodoPagamento.Bonifico || inModifica.Ricevuta is not null))
            {
                <div class="mb-3">
                    <label class="form-label">Ricevuta del bonifico</label>
                    <GestioneRicevuta Pagamento="inModifica" OnCambiato="RicevutaCambiata" />
                </div>
            }
            <button class="btn btn-primary" disabled="@Caricamento">Salva</button>
        </EditForm>
    }
</Finestra>

<Finestra Visibile="daIncassare is not null" Titolo="Registra incasso" OnChiudi="() => daIncassare = null">
    @if (daIncassare is not null)
    {
        <p><strong>@daIncassare.Studente</strong> · @daIncassare.Causale · <strong>@Testo.Euro(daIncassare.Importo)</strong></p>
        <Avvisi Errore="@Errore" />
        <EditForm Model="incasso" OnValidSubmit="Incassa">
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label">Metodo</label>
                    <InputSelect class="form-select" @bind-Value="incasso.Metodo">
                        @foreach (var m in Enum.GetValues<MetodoPagamento>()) { <option value="@m">@Testo.Di(m)</option> }
                    </InputSelect>
                </div>
                <div class="col-6">
                    <label class="form-label">Data incasso</label>
                    <InputDate class="form-control" @bind-Value="incasso.DataPagamento" />
                </div>
            </div>
            @if (incasso.Metodo == MetodoPagamento.Bonifico)
            {
                <div class="mb-3">
                    <label class="form-label">Ricevuta del bonifico <span class="text-body-secondary">(facoltativa)</span></label>
                    <InputFile class="form-control" accept="@Ricevute.Accept" OnChange="e => ricevutaScelta = e.File" />
                    <div class="form-text">Foto (JPG, PNG, HEIC) o PDF, massimo 10 MB. Puoi aggiungerla anche dopo, da «Modifica».</div>
                </div>
            }
            <button class="btn btn-success" disabled="@Caricamento"><i class="bi bi-check-lg"></i> Conferma incasso</button>
        </EditForm>
    }
</Finestra>

@code {
    [SupplyParameterFromQuery] public int? StudenteId { get; set; }
    [SupplyParameterFromQuery] public bool? Scaduti { get; set; }
    [SupplyParameterFromQuery] public int? SedeId { get; set; }

    private List<SedeDto> sedi = [];
    private int? filtroSede;

    /// <summary>Studenti della sede filtrata (tutti se nessun filtro), più quello del pagamento in modifica.</summary>
    private IEnumerable<StudenteDto> StudentiDellaSede => filtroSede is null
        ? studenti
        : studenti.Where(s => s.SedeId == (filtroSede == 0 ? null : filtroSede) || s.Id == modulo?.StudenteId);

    private string NomeFiltroSede => filtroSede switch
    {
        null => "Tutte le sedi",
        0 => "Studenti senza sede",
        var id => sedi.FirstOrDefault(s => s.Id == id)?.Nome ?? "",
    };

    private List<PagamentoDto> pagamenti = [];
    private List<StudenteDto> studenti = [];
    private int? filtroStudente;
    private StatoPagamento? filtroStato;
    private bool soloScaduti;

    private DateOnly meseRiepilogo = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private RiepilogoPagamentiDto? riepilogo;

    private PagamentoInput? modulo;
    private int? idInModifica;
    private PagamentoDto? inModifica;

    private PagamentoDto? daIncassare;
    private RegistraIncassoInput incasso = new();
    private IBrowserFile? ricevutaScelta;

    // Nuovo pagamento già incassato
    private bool incassatoSubito;
    private IBrowserFile? ricevutaNuova;

    private static string IconaMetodo(MetodoPagamento m) => m switch
    {
        MetodoPagamento.Contanti => "bi-cash",
        MetodoPagamento.Bonifico => "bi-bank",
        MetodoPagamento.Carta or MetodoPagamento.Pos => "bi-credit-card",
        MetodoPagamento.Satispay => "bi-phone",
        _ => "bi-wallet2",
    };

    protected override async Task OnInitializedAsync()
    {
        filtroStudente = StudenteId;
        filtroSede = SedeId;
        soloScaduti = Scaduti ?? false;
        await Esegui(async () =>
        {
            studenti = await Api.Studenti(soloAttivi: false);
            sedi = await Api.Sedi();
        });
        await Carica();
    }

    private async Task Carica()
    {
        await Esegui(async () => pagamenti = await Api.Pagamenti(filtroStudente, filtroStato, soloScaduti, filtroSede));
        await CaricaRiepilogo();
    }

    private Task CaricaRiepilogo() =>
        Esegui(async () => riepilogo = await Api.Riepilogo(meseRiepilogo.Year, meseRiepilogo.Month, filtroSede));

    private Task CambiaSede(int? sedeId)
    {
        filtroSede = sedeId;
        // Lo studente filtrato potrebbe non appartenere alla nuova sede.
        if (filtroStudente is { } id && StudentiDellaSede.All(s => s.Id != id)) filtroStudente = null;
        return Carica();
    }

    private Task CambiaMeseRiepilogo(ChangeEventArgs e)
    {
        if (DateOnly.TryParseExact($"{e.Value}-01", "yyyy-MM-dd", out var m)) meseRiepilogo = m;
        return CaricaRiepilogo();
    }

    private Task CambiaStudente(ChangeEventArgs e)
    {
        filtroStudente = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        return Carica();
    }

    private Task CambiaStato(StatoPagamento? stato)
    {
        filtroStato = stato;
        return Carica();
    }

    private void ApriNuovo()
    {
        idInModifica = null;
        inModifica = null;
        Errore = null;
        incassatoSubito = false;
        ricevutaNuova = null;
        modulo = new PagamentoInput { StudenteId = filtroStudente ?? 0 };
    }

    /// <summary>"Già incassato" propone contanti e la data di oggi; "da incassare" li azzera.</summary>
    private void ImpostaIncassato(bool incassato)
    {
        incassatoSubito = incassato;
        modulo!.Metodo = incassato ? MetodoPagamento.Contanti : null;
        modulo.DataPagamento = incassato ? DateOnly.FromDateTime(DateTime.Today) : null;
        if (!incassato) ricevutaNuova = null;
    }

    private void ApriModifica(PagamentoDto p)
    {
        idInModifica = p.Id;
        inModifica = p;
        modulo = PagamentoInput.Da(p);
    }

    /// <summary>La ricevuta si salva subito: aggiorno la riga in tabella senza chiudere il modulo.</summary>
    private void RicevutaCambiata(PagamentoDto aggiornato)
    {
        inModifica = aggiornato;
        var i = pagamenti.FindIndex(x => x.Id == aggiornato.Id);
        if (i >= 0) pagamenti[i] = aggiornato;
    }

    private async Task Salva()
    {
        PagamentoDto? salvato = null;
        if (!await Esegui(async () =>
            salvato = idInModifica is { } id ? await Api.ModificaPagamento(id, modulo!) : await Api.CreaPagamento(modulo!)))
            return;

        // Il pagamento è salvato: un errore sulla ricevuta non lo annulla, lo segnalo e basta.
        string? erroreRicevuta = null;
        if (idInModifica is null && salvato!.Metodo == MetodoPagamento.Bonifico && ricevutaNuova is not null)
        {
            try { await Api.CaricaRicevuta(salvato.Id, ricevutaNuova); }
            catch (ApiException ex) { erroreRicevuta = ex.Message; }
        }

        var bonificoSenzaRicevuta = idInModifica is null && salvato!.Metodo == MetodoPagamento.Bonifico && ricevutaNuova is null;
        modulo = null;
        ricevutaNuova = null;
        await Carica();
        Conferma = salvato!.Stato == StatoPagamento.Pagato
            ? $"Pagamento di {Testo.Euro(salvato.Importo)} registrato ({Testo.Di(salvato.Metodo!.Value)})." +
              (bonificoSenzaRicevuta ? " Ricorda di allegare la ricevuta del bonifico." : "")
            : "Pagamento salvato.";
        if (erroreRicevuta is not null)
            Errore = $"La ricevuta non è stata caricata: {erroreRicevuta} Puoi riprovare da «Modifica».";
    }

    private void ApriIncasso(PagamentoDto p)
    {
        daIncassare = p;
        ricevutaScelta = null;
        incasso = new RegistraIncassoInput { DataPagamento = DateOnly.FromDateTime(DateTime.Today) };
    }

    private async Task Incassa()
    {
        var p = daIncassare!;
        if (!await Esegui(() => Api.RegistraIncasso(p.Id, incasso))) return;

        // L'incasso è registrato: un errore sulla ricevuta non lo annulla, lo segnalo e basta.
        string? erroreRicevuta = null;
        if (incasso.Metodo == MetodoPagamento.Bonifico && ricevutaScelta is not null)
        {
            try { await Api.CaricaRicevuta(p.Id, ricevutaScelta); }
            catch (ApiException ex) { erroreRicevuta = ex.Message; }
        }

        daIncassare = null;
        await Carica();
        Conferma = $"Incassati {Testo.Euro(p.Importo)} da {p.Studente}.";
        if (erroreRicevuta is not null)
            Errore = $"La ricevuta non è stata caricata: {erroreRicevuta} Puoi riprovare da «Modifica».";
    }

    private async Task Annulla(PagamentoDto p)
    {
        if (await Esegui(() => Api.AnnullaPagamento(p.Id))) await Carica();
    }

    private async Task Ripristina(PagamentoDto p)
    {
        if (await Esegui(() => Api.RipristinaPagamento(p.Id))) await Carica();
    }

    private async Task Elimina(PagamentoDto p)
    {
        if (await Esegui(() => Api.EliminaPagamento(p.Id)))
        {
            await Carica();
            Conferma = $"Quota «{p.Causale}» di {p.Studente} eliminata.";
        }
    }
}
