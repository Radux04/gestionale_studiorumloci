@page "/cambia-password"
@layout LayoutAccesso
@inject ApiClient Api
@inject Sessione Sessione
@inject NavigationManager Navigazione

<PageTitle>Cambia password · Studiorum Loci</PageTitle>

<h1 class="h5 mb-1">Cambia password</h1>
@if (Sessione.Utente?.DeveCambiarePassword == true)
{
    <p class="small text-body-secondary">Stai usando una password temporanea: scegline una tua per continuare.</p>
}
else
{
    <p class="small text-body-secondary">Ciao @Sessione.Utente?.Nome, scegli la nuova password.</p>
}

@if (errore is not null)
{
    <div class="alert alert-danger py-2 small" role="alert">@errore</div>
}

<EditForm Model="modulo" OnValidSubmit="Salva" FormName="cambia-password">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label class="form-label" for="attuale">Password attuale</label>
        <InputText id="attuale" class="form-control" type="password" autocomplete="current-password" @bind-Value="modulo.PasswordAttuale" />
        <ValidationMessage For="() => modulo.PasswordAttuale" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="nuova">Nuova password</label>
        <InputText id="nuova" class="form-control" type="password" autocomplete="new-password" @bind-Value="modulo.NuovaPassword" />
        <div class="form-text">Almeno @Ruoli.LunghezzaMinimaPassword caratteri.</div>
        <ValidationMessage For="() => modulo.NuovaPassword" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="conferma">Ripeti la nuova password</label>
        <InputText id="conferma" class="form-control" type="password" autocomplete="new-password" @bind-Value="modulo.ConfermaPassword" />
        <ValidationMessage For="() => modulo.ConfermaPassword" />
    </div>
    <button class="btn btn-primary w-100" disabled="@inCorso">Salva password</button>
</EditForm>

<div class="d-flex justify-content-between mt-3 small">
    @if (Sessione.Utente?.DeveCambiarePassword != true)
    {
        <a href="">Annulla</a>
    }
    <button type="button" class="btn btn-link btn-sm p-0 ms-auto" @onclick="Esci">Esci</button>
</div>

@code {
    private readonly CambiaPasswordInput modulo = new();
    private bool inCorso;
    private string? errore;

    private async Task Salva()
    {
        inCorso = true;
        errore = null;
        try
        {
            // L'API restituisce un nuovo token: quello vecchio non vale più.
            await Sessione.Accedi(await Api.CambiaPassword(modulo));
            Navigazione.NavigateTo("");
        }
        catch (ApiException ex)
        {
            errore = ex.Message;
        }
        finally
        {
            inCorso = false;
        }
    }

    private async Task Esci()
    {
        await Sessione.Esci();
        Navigazione.NavigateTo("login");
    }
}
