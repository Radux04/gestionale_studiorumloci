<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <h1>Accesso negato</h1>
                    <p>Il tuo ruolo non permette di aprire questa pagina. <a href="">Torna alla pagina iniziale</a>.</p>
                }
                else
                {
                    <VaiAlLogin />
                }
            </NotAuthorized>
            <Authorizing>
                <div class="p-4 text-body-secondary"><span class="spinner-border spinner-border-sm"></span> Verifica dell'accesso…</div>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>
