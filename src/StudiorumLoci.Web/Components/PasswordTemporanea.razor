@* Mostra le credenziali appena generate: è l'unica volta in cui la password è visibile. *@
@inject IJSRuntime JS

<Finestra Visibile="Dati is not null" Titolo="Credenziali di accesso" OnChiudi="OnChiudi">
    @if (Dati is not null)
    {
        <div class="alert alert-warning small">
            <i class="bi bi-exclamation-triangle me-1"></i>
            Comunica queste credenziali alla persona interessata: <strong>la password non sarà più visibile</strong>
            dopo aver chiuso questa finestra. Al primo accesso le verrà chiesto di sceglierne una nuova.
        </div>
        <dl class="row mb-3">
            <dt class="col-4">Indirizzo</dt><dd class="col-8 text-break">@Indirizzo</dd>
            <dt class="col-4">Email</dt><dd class="col-8 text-break">@Dati.Email</dd>
            <dt class="col-4">Password</dt>
            <dd class="col-8"><code class="fs-5 user-select-all">@Dati.PasswordTemporanea</code></dd>
        </dl>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" @onclick="Copia">
                <i class="bi @(copiato ? "bi-check-lg" : "bi-clipboard")"></i> @(copiato ? "Copiato" : "Copia tutto")
            </button>
            <button class="btn btn-primary ms-auto" @onclick="OnChiudi">Ho annotato le credenziali</button>
        </div>
    }
</Finestra>

@code {
    [Parameter] public PasswordTemporaneaDto? Dati { get; set; }
    [Parameter] public EventCallback OnChiudi { get; set; }
    [Inject] private NavigationManager Navigazione { get; set; } = null!;

    private bool copiato;
    private string Indirizzo => Navigazione.BaseUri + "login";

    protected override void OnParametersSet() => copiato = false;

    private async Task Copia()
    {
        var testo = $"Gestionale Studiorum Loci\nIndirizzo: {Indirizzo}\nEmail: {Dati!.Email}\nPassword temporanea: {Dati.PasswordTemporanea}";
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", testo);
            copiato = true;
        }
        catch (JSException) { /* appunti non disponibili: resta la selezione manuale */ }
    }
}
