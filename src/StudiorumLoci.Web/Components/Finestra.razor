@* Finestra modale Bootstrap gestita da Blazor (senza JavaScript). *@

@if (Visibile)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" @onkeydown="Tasto">
        <div class="modal-dialog modal-dialog-scrollable @(Grande ? "modal-lg" : "")">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Titolo</h5>
                    <button type="button" class="btn-close" aria-label="Chiudi" @onclick="OnChiudi"></button>
                </div>
                <div class="modal-body">
                    @ChildContent
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public bool Visibile { get; set; }
    [Parameter] public string Titolo { get; set; } = "";
    [Parameter] public bool Grande { get; set; }
    [Parameter] public EventCallback OnChiudi { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task Tasto(KeyboardEventArgs e) => e.Key == "Escape" ? OnChiudi.InvokeAsync() : Task.CompletedTask;
}
