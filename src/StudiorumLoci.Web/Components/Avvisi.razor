@* Messaggi di errore e conferma mostrati in cima alla pagina. *@

@if (Errore is not null)
{
    <div class="alert alert-danger d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@Errore
    </div>
}
@if (Conferma is not null)
{
    <div class="alert alert-success d-flex align-items-center" role="status">
        <i class="bi bi-check-circle me-2"></i>@Conferma
    </div>
}

@code {
    [Parameter] public string? Errore { get; set; }
    [Parameter] public string? Conferma { get; set; }
}
