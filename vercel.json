{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "curl -sSL https://dot.net/v1/dotnet-install.sh -o dotnet-install.sh && bash dotnet-install.sh --channel 10.0 --install-dir ./.dotnet",
  "buildCommand": "DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 DOTNET_CLI_TELEMETRY_OPTOUT=1 ./.dotnet/dotnet publish src/StudiorumLoci.Web -c Release -o out",
  "outputDirectory": "out/wwwroot",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
